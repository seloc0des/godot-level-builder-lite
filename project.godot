; Engine configuration file.

config_version=5

[application]

config/name="Level Builder Lite"
config/description="Room-scope 3D level assembly dock for Godot 4.5+. Open demo/showcase_walk.tscn and press F6."
run/main_scene="res://demo/showcase_walk.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/level_builder/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
